# ==============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored - never commit it.
#   cp .env.example .env.local
# ==============================================================================

# ---- AI (Google Gemini) ------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
# Server-side only. This value is NEVER sent to the browser.
GEMINI_API_KEY=

# Generative model used for structured request extraction + customer responses.
# Pinned to a dated snapshot on purpose: `-latest` aliases shift under you, and a
# reviewer re-running this demo next month should get the same results.
CHAT_MODEL=gemini-3.5-flash-lite

# Embedding model used for policy retrieval (RAG).
EMBED_MODEL=gemini-embedding-2

# Must match the value stored in policy_chunks.embedding vector(N).
# 1536 is a supported Matryoshka truncation of the model's 3072 native output.
EMBED_DIM=1536

# ---- Authentication ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public origin of the API (used for cookie/CORS origin checks).
BETTER_AUTH_URL=http://localhost:4000

# ---- Ports -------------------------------------------------------------------
API_PORT=4000
WEB_PORT=5173
# Host-side published DB port. Containers always reach the database at db:5432.
# 5433 avoids colliding with a locally installed PostgreSQL on 5432.
DB_PORT=5433

# ---- Database ----------------------------------------------------------------
POSTGRES_USER=refund
POSTGRES_PASSWORD=refund_local_dev
POSTGRES_DB=refund_ai

# Marks session cookies `Secure` (HTTPS-only). Keep false for the local HTTP
# demo, or login will appear to work while every later request is unauthenticated.
COOKIE_SECURE=false
